    "var_ceff37765cf0": {
      "type": "variant",
      "label": "Instrument / Lab Dashboard",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 6160,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  :root{--bg:#0D0E12;--surface:#141519;--surface2:#191B20;--hair:#272930;--hair2:#343741;--text:#E4E7EB;--muted:#868A93;--faint:#5D626C;--orange:#FF6B00;--green:#34D399;--amber:#FBBF24;--lav:#C084FC;--mono:'JetBrains Mono',monospace;--sans:'Inter',sans-serif}\n  body{margin:0;background:var(--bg);color:var(--text);font-family:var(--sans);font-size:13px;line-height:1.45}\n  button,a{font:inherit;color:inherit;text-decoration:none}\n  .mono{font-family:var(--mono);font-variant-numeric:tabular-nums}\n  .shell{min-height:100vh;background:var(--bg)}\n  .top{height:64px;display:flex;align-items:center;gap:28px;padding:0 38px;border-bottom:1px solid var(--hair);background:#101115}\n  .brand{display:flex;align-items:center;gap:10px;min-width:218px}\n  .brand-mark{width:31px;height:31px;display:grid;place-items:center;border:1px solid #76512e;color:var(--orange);font-size:17px}\n  .brand-name{font-size:15px;font-weight:700;letter-spacing:.18em;text-transform:uppercase}\n  .brand-sub{margin-top:1px;color:var(--muted);font:10px var(--mono);letter-spacing:.13em;text-transform:uppercase}\n  .nav{height:100%;display:flex;align-items:center;gap:26px;flex:1}\n  .nav a{position:relative;height:100%;display:flex;align-items:center;color:var(--muted);font-size:12px;font-weight:600}\n  .nav a.active{color:var(--text)}\n  .nav a.active:after{position:absolute;content:'';left:0;right:0;bottom:-1px;height:2px;background:var(--orange)}\n  .focus{min-width:220px;height:39px;display:flex;align-items:center;gap:10px;padding:0 12px;border:1px solid var(--hair);background:var(--surface)}\n  .signal{width:7px;height:7px;background:var(--green);display:inline-block}\n  .focus small,.sync small{display:block;color:var(--muted);font-size:9px;letter-spacing:.1em;text-transform:uppercase}\n  .focus strong{display:block;font:600 12px var(--mono)}\n  .sync{display:flex;align-items:center;gap:8px;color:var(--green);font:11px var(--mono);white-space:nowrap}\n  .settings{width:34px;height:34px;display:grid;place-items:center;border:1px solid var(--hair);color:var(--muted)}\n  .avatar{width:34px;height:34px;display:grid;place-items:center;border:1px solid #76512e;color:var(--orange);font:600 11px var(--mono);background:#1c1713}\n  .utility{height:53px;display:flex;align-items:center;justify-content:space-between;padding:0 38px;border-bottom:1px solid var(--hair);background:#111216}\n  .crumb small{display:block;color:var(--orange);font:600 10px var(--mono);letter-spacing:.11em;text-transform:uppercase}\n  .crumb strong{display:block;margin-top:2px;color:var(--muted);font:400 11px var(--mono)}\n  .utility-actions{display:flex;gap:8px;align-items:center}\n  .btn{height:34px;display:inline-flex;align-items:center;gap:8px;padding:0 13px;border:1px solid var(--hair2);background:transparent;color:var(--muted);font-size:11px;font-weight:600}\n  .btn.primary{border-color:var(--orange);background:var(--orange);color:#111216}\n  .btn:hover{border-color:var(--orange);color:var(--text)}\n  .btn.primary:hover{color:#111216}\n  main{width:min(1364px,calc(100% - 76px));margin:0 auto;padding:34px 0 72px}\n  .hero{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;padding-bottom:28px;border-bottom:1px solid var(--hair)}\n  .eyebrow{margin:0 0 8px;color:var(--orange);font:600 10px var(--mono);letter-spacing:.11em;text-transform:uppercase}\n  h1{margin:0;font-size:32px;line-height:1.1;letter-spacing:-.04em;font-weight:600}\n  .hero p:not(.eyebrow){margin:10px 0 0;color:var(--muted);font-size:14px}\n  .hero-actions{display:flex;gap:8px;flex:0 0 auto}\n  .kpis{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid var(--hair);background:var(--surface)}\n  .kpi{min-height:83px;padding:17px 18px;border-right:1px solid var(--hair)}\n  .kpi:last-child{border-right:0}\n  .kpi-label{color:var(--muted);font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase}\n  .kpi-row{display:flex;align-items:baseline;justify-content:space-between;gap:10px;margin-top:7px}\n  .kpi-value{font:600 27px var(--mono);letter-spacing:-.06em}\n  .kpi-note{color:var(--orange);font:10px var(--mono)}\n  .core{display:grid;grid-template-columns:4fr 8fr;gap:24px;margin-top:24px}\n  .column{min-width:0;display:flex;flex-direction:column;gap:24px}\n  .module{min-width:0;border:1px solid var(--hair);background:var(--surface)}\n  .module-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;padding:17px 18px 14px;border-bottom:1px solid var(--hair)}\n  .module-title{margin:0;font-size:15px;font-weight:600;letter-spacing:-.02em}\n  .module-meta{margin:4px 0 0;color:var(--muted);font:10px var(--mono);letter-spacing:.05em;text-transform:uppercase}\n  .module-icon{color:var(--muted);font-size:16px}\n  .module-link{display:inline-flex;align-items:center;gap:6px;color:var(--orange);font:600 10px var(--mono);letter-spacing:.05em;text-transform:uppercase}\n  .empty{min-height:168px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px;text-align:center}\n  .empty-mark{width:34px;height:34px;display:grid;place-items:center;margin-bottom:11px;border:1px solid var(--hair2);color:var(--green);font-size:17px}\n  .empty strong{font-size:13px;font-weight:600}\n  .empty p{max-width:280px;margin:5px 0 15px;color:var(--muted);font-size:11px}\n  .momentum{padding:16px 18px 15px}\n  .momentum-head{display:flex;justify-content:space-between;align-items:flex-start}\n  .momentum-total{font:600 30px var(--mono);line-height:1;color:var(--text)}\n  .momentum-total small{display:block;margin-top:5px;color:var(--muted);font:10px var(--sans)}\n  .chart{display:grid;grid-template-columns:24px 1fr;gap:8px;height:129px;margin-top:18px}\n  .y-axis{display:flex;flex-direction:column;justify-content:space-between;color:var(--faint);font:9px var(--mono);padding-bottom:18px}\n  .plot{position:relative;display:grid;grid-template-columns:repeat(7,1fr);align-items:end;gap:10px;border-bottom:1px solid var(--hair2);background:linear-gradient(to bottom,transparent 49%,var(--hair) 50%,transparent 51%)}\n  .bar-wrap{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:6px}\n  .bar{width:100%;max-width:22px;background:var(--muted);min-height:3px}\n  .bar.active{background:var(--orange)}\n  .bar.peak{background:var(--green)}\n  .day{color:var(--faint);font:9px var(--mono)}\n  .annotation{position:absolute;right:11%;top:6px;color:var(--green);font:9px var(--mono);letter-spacing:.04em}\n  .annotation:after{content:'';position:absolute;top:14px;left:18px;width:1px;height:58px;background:var(--green)}\n  .life{padding-bottom:16px}\n  .life-summary{display:grid;grid-template-columns:repeat(3,1fr);margin:15px 18px 17px;border:1px solid var(--hair)}\n  .life-stat{padding:12px 13px;border-right:1px solid var(--hair)}\n  .life-stat:last-child{border-right:0}\n  .life-stat strong{display:block;font:600 20px var(--mono)}\n  .life-stat span{display:block;margin-top:3px;color:var(--muted);font-size:10px}\n  .matrix-wrap{padding:0 18px}\n  .matrix{display:grid;grid-template-columns:repeat(52,1fr);grid-template-rows:repeat(7,9px);grid-auto-flow:column;gap:3px;height:81px}\n  .cell{background:#1C1E23}\n  .cell.green{background:#245D4E}.cell.orange{background:#A74A12}.cell.lav{background:#6C478F}.cell.dim{background:#2A2D34}\n  .axis{display:flex;justify-content:space-between;margin-top:10px;color:var(--faint);font:9px var(--mono)}\n  .objectives{padding-bottom:0}\n  .objective{display:grid;grid-template-columns:minmax(220px,1.2fr) minmax(170px,1fr) minmax(150px,.8fr);gap:22px;align-items:center;padding:15px 18px;border-bottom:1px solid var(--hair)}\n  .objective:last-child{border-bottom:0}\n  .objective-area{margin-bottom:4px;color:var(--orange);font:600 10px var(--mono);letter-spacing:.07em;text-transform:uppercase}\n  .objective-title{margin:0;font-size:13px;font-weight:600}\n  .objective-copy{margin:4px 0 0;color:var(--muted);font-size:11px;line-height:1.4}\n  .progress-top{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:7px;color:var(--muted);font:10px var(--mono)}\n  .progress-top strong{color:var(--text);font-weight:600}\n  .track{height:5px;background:#25272D}\n  .track span{display:block;height:100%;background:var(--orange)}\n  .next{display:flex;flex-direction:column;align-items:flex-end;text-align:right}\n  .next small{color:var(--muted);font:9px var(--mono);letter-spacing:.06em;text-transform:uppercase}\n  .next strong{margin-top:4px;font-size:11px;font-weight:600}\n  .next span{margin-top:4px;color:var(--muted);font:10px var(--mono)}\n  .priority{display:inline-flex;align-items:center;gap:5px;margin-top:7px;color:var(--muted);font:9px var(--mono);text-transform:uppercase}\n  .priority i{color:var(--amber);font-size:12px}\n  .lower{display:grid;grid-template-columns:4fr 8fr;gap:24px;margin-top:24px}\n  .telemetry{padding-bottom:10px}\n  .telemetry-row{display:grid;grid-template-columns:8px minmax(0,1fr) auto;align-items:center;gap:11px;padding:13px 18px;border-bottom:1px solid var(--hair)}\n  .telemetry-row:last-of-type{border-bottom:0}\n  .status-dot{width:7px;height:7px;background:var(--green)}\n  .telemetry-name{font-size:12px;font-weight:600}.telemetry-sub{display:block;margin-top:2px;color:var(--muted);font:10px var(--mono)}\n  .telemetry-count{color:var(--muted);font:10px var(--mono)}\n  .telemetry .module-link{margin:6px 18px 0}\n  .reflection{position:relative;display:grid;grid-template-columns:4px 1fr auto;gap:18px;align-items:center;min-height:142px;padding:19px 20px}\n  .reflection-rail{height:100%;background:var(--lav)}\n  .reflection h2{margin:0;font-size:17px;font-weight:600}.reflection p{margin:5px 0 0;color:var(--muted);font-size:12px}\n  .reflection .btn{border-color:var(--hair2);white-space:nowrap}\n  footer{height:28px;display:flex;align-items:center;gap:28px;padding:0 38px;border-top:1px solid var(--hair);color:var(--muted);background:#101115;font:9px var(--mono);letter-spacing:.08em;text-transform:uppercase}\n  footer span:first-child{margin-right:auto;color:var(--green)}\n  @media(max-width:900px){.top{padding:0 18px;gap:15px}.nav{gap:12px}.focus{display:none}main{width:calc(100% - 36px)}.core,.lower{grid-template-columns:1fr}.objective{grid-template-columns:1fr;gap:12px}.next{align-items:flex-start;text-align:left}.hero{align-items:flex-start;flex-direction:column}.kpis{grid-template-columns:repeat(2,1fr)}.kpi:nth-child(2){border-right:0}.kpi:nth-child(-n+2){border-bottom:1px solid var(--hair)}footer{padding:0 18px}}\n</style>\n<div class=\"shell\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"top\" data-kid=\"1-1\" data-name=\"main navigation bar\">\n        <div class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand area\">\n            <span class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"brand logo icon\">\n                <i class=\"ti ti-sparkles\" data-kid=\"1-1-1-1-1\" data-name=\"sparkles icon\">\n                </i>\n            </span>\n            <div data-kid=\"1-1-1-2\" data-name=\"brand identity container\">\n                <div class=\"brand-name\" data-kid=\"1-1-1-2-1\" data-name=\"brand name text\">\n                    Evolvra\n                </div>\n                <div class=\"brand-sub\" data-kid=\"1-1-1-2-2\" data-name=\"brand subtitle text\">\n                    Personal OS\n                </div>\n            </div>\n        </div>\n        <nav class=\"nav\" data-kid=\"1-1-2\" data-name=\"main navigation menu\">\n            <a class=\"active\" data-kid=\"1-1-2-1\" data-name=\"navigation link\" href=\"#\">\n                Command Centre\n            </a>\n            <a data-kid=\"1-1-2-2\" data-name=\"navigation link\" href=\"#\">\n                Goals\n            </a>\n            <a data-kid=\"1-1-2-3\" data-name=\"navigation link\" href=\"#\">\n                Quests\n            </a>\n            <a data-kid=\"1-1-2-4\" data-name=\"navigation link\" href=\"#\">\n                Stats\n            </a>\n            <a data-kid=\"1-1-2-5\" data-name=\"navigation link\" href=\"#\">\n                Reviews\n            </a>\n            <a data-kid=\"1-1-2-6\" data-name=\"navigation link\" href=\"#\">\n                Timeline\n            </a>\n        </nav>\n        <div class=\"focus\" data-kid=\"1-1-3\" data-name=\"focus status container\">\n            <span class=\"signal\" data-kid=\"1-1-3-1\" data-name=\"active status signal\">\n            </span>\n            <div data-kid=\"1-1-3-2\" data-name=\"focus details container\">\n                <small data-kid=\"1-1-3-2-1\" data-name=\"focus label text\">\n                    Current focus\n                </small>\n                <strong data-dynamic=\"true\" data-kid=\"1-1-3-2-2\" data-name=\"active goals count\" data-reason=\"value dynamically updated by application state\">\n                    3 active goals\n                </strong>\n            </div>\n        </div>\n        <div class=\"sync\" data-kid=\"1-1-4\" data-name=\"sync status indicator\">\n            <span class=\"signal\" data-kid=\"1-1-4-1\" data-name=\"sync status signal\">\n            </span>\n            <span data-kid=\"1-1-4-2\" data-name=\"sync status text\">\n                PRIVATE / LOCAL\n            </span>\n        </div>\n        <span class=\"settings\" data-kid=\"1-1-5\" data-name=\"settings button\">\n            <i class=\"ti ti-settings\" data-kid=\"1-1-5-1\" data-name=\"settings icon\">\n            </i>\n        </span>\n        <span class=\"avatar\" data-kid=\"1-1-6\" data-name=\"user avatar\">\n            AL\n        </span>\n    </header>\n    <div class=\"utility\" data-kid=\"1-2\" data-name=\"utility header\">\n        <div class=\"crumb\" data-kid=\"1-2-1\" data-name=\"breadcrumb container\">\n            <small data-kid=\"1-2-1-1\" data-name=\"breadcrumb label\">\n                Workspace / Command Centre\n            </small>\n            <strong data-kid=\"1-2-1-2\" data-name=\"page title\">\n                Building a life with direction\n            </strong>\n        </div>\n        <div class=\"utility-actions\" data-kid=\"1-2-2\" data-name=\"utility actions container\">\n            <button class=\"btn\" data-kid=\"1-2-2-1\" data-name=\"undo action button\">\n                <i class=\"ti ti-rotate-2\" data-kid=\"1-2-2-1-1\" data-name=\"undo icon\">\n                </i>\n                Undo\n            </button>\n            <button class=\"btn primary\" data-kid=\"1-2-2-2\" data-name=\"new goal action button\">\n                <i class=\"ti ti-plus\" data-kid=\"1-2-2-2-1\" data-name=\"plus icon\">\n                </i>\n                New goal\n            </button>\n        </div>\n    </div>\n    <main data-kid=\"1-3\" data-name=\"main content area\">\n        <section class=\"hero\" data-kid=\"1-3-1\" data-name=\"hero section\">\n            <div data-kid=\"1-3-1-1\" data-name=\"hero copy container\">\n                <p class=\"eyebrow\" data-kid=\"1-3-1-1-1\" data-name=\"greeting text\">\n                    Good morning, Alex\n                </p>\n                <h1 data-kid=\"1-3-1-1-2\" data-name=\"hero headline\">\n                    What will move your life forward?\n                </h1>\n                <p data-kid=\"1-3-1-1-3\" data-name=\"hero subheadline\">\n                    Choose the next meaningful action. Quiet progress still counts.\n                </p>\n            </div>\n            <div class=\"hero-actions\" data-kid=\"1-3-1-2\" data-name=\"hero actions container\">\n                <button class=\"btn\" data-kid=\"1-3-1-2-1\" data-name=\"view today button\">\n                    View today\n                    <i class=\"ti ti-arrow-up-right\" data-kid=\"1-3-1-2-1-1\" data-name=\"arrow icon\">\n                    </i>\n                </button>\n                <button class=\"btn primary\" data-kid=\"1-3-1-2-2\" data-name=\"new goal button\">\n                    <i class=\"ti ti-plus\" data-kid=\"1-3-1-2-2-1\" data-name=\"plus icon\">\n                    </i>\n                    New goal\n                </button>\n            </div>\n        </section>\n        <section aria-label=\"Progress overview\" class=\"kpis\" data-kid=\"1-3-2\" data-name=\"kpi progress overview section\">\n            <div class=\"kpi\" data-kid=\"1-3-2-1\" data-name=\"kpi metric card\">\n                <div class=\"kpi-label\" data-kid=\"1-3-2-1-1\" data-name=\"kpi label\">\n                    Active goals\n                </div>\n                <div class=\"kpi-row\" data-kid=\"1-3-2-1-2\" data-name=\"kpi data row\">\n                    <strong class=\"kpi-value\" data-dynamic=\"true\" data-kid=\"1-3-2-1-2-1\" data-name=\"kpi numeric value\" data-reason=\"value dynamically updated by application state\">\n                        3\n                    </strong>\n                    <span class=\"kpi-note\" data-kid=\"1-3-2-1-2-2\" data-name=\"kpi note text\">\n                        OPEN OBJECTIVES\n                    </span>\n                </div>\n            </div>\n            <div class=\"kpi\" data-kid=\"1-3-2-2\" data-name=\"kpi metric card\">\n                <div class=\"kpi-label\" data-kid=\"1-3-2-2-1\" data-name=\"kpi label\">\n                    Quests completed\n                </div>\n                <div class=\"kpi-row\" data-kid=\"1-3-2-2-2\" data-name=\"kpi data row\">\n                    <strong class=\"kpi-value\" data-dynamic=\"true\" data-kid=\"1-3-2-2-2-1\" data-name=\"kpi numeric value\" data-reason=\"value dynamically updated by application state\">\n                        0\n                    </strong>\n                    <span class=\"kpi-not
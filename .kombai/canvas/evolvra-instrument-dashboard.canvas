"cell ${i===218?'orange':i===219?'lav':i===220?'green':i%41===0?'dim':''}\"></span>`).join('')\n                        </script>\n                        <div class=\"axis\" data-kid=\"1-3-3-2-1-3-2\" data-name=\"matrix axis labels\">\n                            <span data-kid=\"1-3-3-2-1-3-2-1\" data-name=\"label start\">\n                                JAN 01\n                            </span>\n                            <span data-kid=\"1-3-3-2-1-3-2-2\" data-name=\"label middle\">\n                                JUN 30\n                            </span>\n                            <span data-kid=\"1-3-3-2-1-3-2-3\" data-name=\"label end\">\n                                DEC 31\n                            </span>\n                        </div>\n                    </div>\n                </section>\n                <section class=\"module objectives\" data-kid=\"1-3-3-2-2\" data-name=\"objectives module\">\n                    <div class=\"module-head\" data-kid=\"1-3-3-2-2-1\" data-name=\"module header\">\n                        <div data-kid=\"1-3-3-2-2-1-1\" data-name=\"module info\">\n                            <p class=\"module-meta\" data-kid=\"1-3-3-2-2-1-1-1\" data-name=\"module meta label\">\n                                Active objectives\n                            </p>\n                            <h2 class=\"module-title\" data-kid=\"1-3-3-2-2-1-1-2\" data-name=\"module title\">\n                                Your current goals\n                            </h2>\n                        </div>\n                        <a class=\"module-link\" data-kid=\"1-3-3-2-2-1-2\" data-name=\"action link\" href=\"#\">\n                            View all\n                            <i class=\"ti ti-arrow-up-right\" data-kid=\"1-3-3-2-2-1-2-1\" data-name=\"arrow icon\">\n                            </i>\n                        </a>\n                    </div>\n                    <div class=\"objective\" data-kid=\"1-3-3-2-2-2\" data-name=
n                            </i>\n                        </span>\n                    </div>\n                    <div class=\"life-summary\" data-kid=\"1-3-3-2-1-2\" data-name=\"life summary stats container\">\n                        <div class=\"life-stat\" data-kid=\"1-3-3-2-1-2-1\" data-name=\"stat card\">\n                            <strong data-dynamic=\"true\" data-kid=\"1-3-3-2-1-2-1-1\" data-name=\"stat value\" data-reason=\"value dynamically updated by application state\">\n                                64%\n                            </strong>\n                            <span data-kid=\"1-3-3-2-1-2-1-2\" data-name=\"stat description\">\n                                of the year lived\n                            </span>\n                        </div>\n                        <div class=\"life-stat\" data-kid=\"1-3-3-2-1-2-2\" data-name=\"stat card\">\n                            <strong data-dynamic=\"true\" data-kid=\"1-3-3-2-1-2-2-1\" data-name=\"stat value\" data-reason=\"value dynamically updated by application state\">\n                                —\n                            </strong>\n                            <span data-kid=\"1-3-3-2-1-2-2-2\" data-name=\"stat description\">\n                                add age in settings\n                            </span>\n                        </div>\n                        <div class=\"life-stat\" data-kid=\"1-3-3-2-1-2-3\" data-name=\"stat card\">\n                            <strong data-dynamic=\"true\" data-kid=\"1-3-3-2-1-2-3-1\" data-name=\"stat value\" data-reason=\"value dynamically updated by application state\">\n                                1\n                            </strong>\n                            <span data-kid=\"1-3-3-2-1-2-3-2\" data-name=\"stat description\">\n                                days with recorded activity\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"matr